{
  "expo": {
    "name": "Cachelog",
    "slug": "cachelog",
    "scheme": "cachelog",
    "version": "0.3.0",
    "backgroundColor": "#0B0B0D",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cachelog.app",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Cachelog file",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.cachelog.file"
            ]
          },
          {
            "CFBundleTypeName": "Block map",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf",
              "public.tiff"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.cachelog.file",
            "UTTypeDescription": "Cachelog file",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "cachelog"
              ],
              "public.mime-type": [
                "application/vnd.cachelog+json"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "package": "com.cachelog.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cachelog shows your position on the block map so you can find your piece and caches."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "800fd43e-7bca-49d9-b469-85868bd49a4f"
      }
    },
    "owner": "mzeee"
  }
}
